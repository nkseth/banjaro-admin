# Banjaro Admin — copy to .env.local

# Session signing key for next-auth. Generate one: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Bootstrap admin, for the first sign-in before any `admins` document exists.
# Leave both blank in production — without them the only way in is an `admins`
# document with a scrypt passwordHash (node scripts/make-admin-hash.mjs).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# The Firebase project this console administers. Credentials come from
# service-account.json in the project root (or GOOGLE_APPLICATION_CREDENTIALS);
# the service account's project_id must match this or startup refuses.
BANJARO_PROJECT_ID=banjaro-44abb
